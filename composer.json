{
    "name": "largerio/laravel-concurrency-limit",
    "description": "Cap in-flight HTTP requests and concurrent queued jobs per user, tenant or key in Laravel.",
    "keywords": [
        "laravel",
        "concurrency",
        "concurrency-limit",
        "middleware",
        "job-middleware",
        "queue",
        "fairness"
    ],
    "homepage": "https://github.com/largerio/laravel-concurrency-limit",
    "license": "MIT",
    "authors": [
        {
            "name": "Louis",
            "email": "louis@larger.io",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/cache": "^12.53 || ^13.0",
        "illuminate/contracts": "^12.53 || ^13.0",
        "illuminate/http": "^12.53 || ^13.0",
        "illuminate/queue": "^12.53 || ^13.0",
        "illuminate/routing": "^12.53 || ^13.0",
        "illuminate/support": "^12.53 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Largerio\\ConcurrencyLimit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Largerio\\ConcurrencyLimit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": [
            "@composer validate --strict",
            "pint --test",
            "rector process --dry-run"
        ],
        "format": [
            "rector process",
            "pint"
        ],
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "pest",
        "coverage": "pest --coverage --min=100"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "lock": false,
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Largerio\\ConcurrencyLimit\\ConcurrencyLimitServiceProvider"
            ]
        }
    }
}
