# Development image only: the package itself ships no image. Every base is
# pinned by digest; Dependabot bumps tag and digest together.
#
# PHP_VERSION selects one of the php-* stages below (8.4 or 8.5).
ARG PHP_VERSION=8.5

FROM composer:2.11.2@sha256:5bcb28b8d0edc4091125f8218f9d088f998bdfc843f8fbb9a4beb4dcd8625684 AS composer
FROM mlocati/php-extension-installer:2.13.2@sha256:4fd45396c16685266d32bf147a24ecd5e81029d3820295895bf4a90131190ac9 AS php-extension-installer

FROM php:8.4.28RC1-cli-alpine3.24@sha256:ac2ff9c5a33cc1554fce0c138e7e9cc3ca6f71d01dc306696562eb2f7f7d6b71 AS php-8.4
FROM php:8.5.12-cli-alpine3.24@sha256:1ff5b45922ab30f418447c6089dbe2eba5f01e0b2742863d0327ac349305d70f AS php-8.5

# A stage defined above, already pinned by digest.
# hadolint ignore=DL3006
FROM php-${PHP_VERSION}

# pcov for coverage, pcntl for the multi-process integration suite, redis
# (phpredis) and memcached for the stores under test; pdo_sqlite ships with the
# base image. The installer is bind-mounted, so it never lands in a layer, and
# it removes the build dependencies it adds once the extensions are compiled.
#
# The container runs as the host user (see docker-compose.dev.yml), who has no
# home directory here: COMPOSER_HOME and its cache are world-writable, and the
# named volume mounted on the cache copies these permissions.
# hadolint ignore=DL3018
RUN --mount=type=bind,from=php-extension-installer,source=/usr/bin/install-php-extensions,target=/usr/local/bin/install-php-extensions \
    apk add --no-cache git unzip \
    && install-php-extensions memcached pcntl pcov redis \
    && git config --system --add safe.directory /app \
    && mkdir -p /composer/cache \
    && chmod -R 1777 /composer

COPY --from=composer --link /usr/bin/composer /usr/local/bin/composer

ENV COMPOSER_HOME=/composer

# Never root, even when the image is run without docker-compose.dev.yml.
USER 1000:1000

WORKDIR /app
